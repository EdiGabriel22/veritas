---
import { asset, stats } from "../data/site";
---

<section class="hero" id="topo">
  <div class="hero-media" aria-hidden="true">
    <img src={asset("/images/hero.png")} alt="" />
  </div>
  <div class="hero-content">
    <p class="badge" data-reveal style="--reveal: 80ms">
      <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
        <path d="M10 1.5 3.5 10.2h4.2L7.2 16.5 14.5 7.2H10.2L10 1.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"></path>
      </svg>
      GESTORA DE ENERGIA
    </p>
    <h1 data-reveal style="--reveal: 180ms">Sua energia gerida de perto, <span>do contrato à fatura.</span></h1>
    <p class="hero-text" data-reveal style="--reveal: 300ms">
      A Veritas conduz a migração para o mercado livre, cuida de todos os trâmites na CCEE e confere cada fatura.
      Do estudo inicial às reuniões de acompanhamento, você fala direto com um engenheiro.
    </p>
    <div class="hero-actions" data-reveal style="--reveal: 420ms">
      <a class="btn btn-fill btn-lg" href="#contato">
        Solicitar análise gratuita
        <img src={asset("/icons/arrow-right.svg")} alt="" width="18" height="18" />
      </a>
      <a class="btn btn-ghost btn-lg" href="#servicos">Conhecer os serviços</a>
    </div>
  </div>
</section>
<section class="stats-bar" aria-label="Destaques">
  <div class="stats">
    {
      stats.map((stat, index) => (
        <div data-reveal style={`--reveal: ${index * 80}ms`}>
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))
    }
  </div>
</section>
