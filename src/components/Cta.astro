---
import { contact } from "../data/site";
---

<section class="section cta">
  <div class="container">
    <p class="eyebrow" data-reveal>Comece agora</p>
    <h2 data-reveal style="--reveal: 100ms">A análise é gratuita.<br />Descubra quanto sua empresa pode economizar.</h2>
    <p class="section-lead lead-muted" data-reveal style="--reveal: 180ms">
      Envie suas faturas recentes. Um engenheiro da Veritas analisa o perfil de consumo, cota com as comercializadoras
      parceiras e apresenta o resultado em uma reunião.
    </p>
    <div class="cta-actions" data-reveal style="--reveal: 260ms">
      <a class="btn btn-lg" href="#contato">Solicitar análise gratuita</a>
      <a class="btn btn-lg" href={contact.whatsapp} target="_blank" rel="noopener noreferrer">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M6.2 18.8 5 21.5l2.8-1.1A8.7 8.7 0 1 0 6.2 18.8Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"></path>
          <path d="M9.1 9.4c.2-.5.4-.5.7-.5h.5c.2 0 .4 0 .5.4.2.5.6 1.6.6 1.7.1.2 0 .4-.1.5l-.4.5c-.1.2-.3.3-.1.6.2.3.8 1.2 1.7 1.9.7.5 1.3.7 1.6.6.2-.1.7-.7.9-.9.1-.2.3-.1.5-.1l1.2.6c.2.1.4.2.4.4.1.5-.1 1.4-.7 1.9-.5.4-1.2.6-2 .5-1.5-.2-3.6-1.2-5-2.8-1.1-1.3-2-2.9-2.1-3.3-.3-.8.2-1.8.8-2.6Z" fill="currentColor"></path>
        </svg>
        Falar pelo WhatsApp
      </a>
    </div>
  </div>
</section>
