---
import { contact, footer } from "../data/site";
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand" data-reveal="left">
        <img src="/icons/logo.svg" alt="Veritas" width="151" height="32" />
        <p>{footer.blurb}</p>
        <div class="footer-contact">
          <p>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><rect x="1.5" y="3.2" width="13" height="9.6" rx="1.4" stroke="currentColor" stroke-width="1.4"></rect><path d="m2.2 4.2 5.8 4.2 5.8-4.2" stroke="currentColor" stroke-width="1.4" stroke-linejoin="round"></path></svg>
            <a href={`mailto:${contact.email}`}>{contact.email}</a>
          </p>
          <p>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4.2 2.8h2L7.4 6 5.8 7.2a8 8 0 0 0 3 3L10 8.6l3.2 1.2v2A1.2 1.2 0 0 1 12 13 9.2 9.2 0 0 1 3 4a1.2 1.2 0 0 1 1.2-1.2Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"></path></svg>
            <a href={`tel:${contact.phoneTel}`}>{contact.phoneDisplay}</a>
          </p>
          <p>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M8 14s4.5-3.6 4.5-7A4.5 4.5 0 0 0 8 2.5 4.5 4.5 0 0 0 3.5 7C3.5 10.4 8 14 8 14Z" stroke="currentColor" stroke-width="1.4"></path><circle cx="8" cy="7" r="1.4" stroke="currentColor" stroke-width="1.4"></circle></svg>
            {contact.city}
          </p>
        </div>
      </div>
      <div class="footer-cols">
        {
          footer.columns.map((column, columnIndex) => (
            <div data-reveal style={`--reveal: ${columnIndex * 80}ms`}>
              <h2>{column.title}</h2>
              {column.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          ))
        }
      </div>
    </div>
    <div class="legal-row" data-reveal="fade">
      <p>© 2026 Veritas Energia. Todos os direitos reservados.</p>
      <p>veritasenergia.com</p>
    </div>
  </div>
</footer>
